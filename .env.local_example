CLIENT_ID=sdf
CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=some-jwt-secret
DISABLE_DRUPAL_TRANSLATE=1
LOGIN_PATH=https://stg.login.bib.dk
ALLOW_ROBOTS=true

# AI search: token for the LLM gateway (server-side only). Optional: LLM_BASE_URL, LLM_MODEL, LLM_TIMEOUT_MS
LLMTOKEN=

# AI search v3 (/api/ai/v3/cql): OpenRouter key (server-side only).
# Optional: OPENROUTER_MODEL, OPENROUTER_FALLBACK_MODELS (comma separated), OPENROUTER_BASE_URL, OPENROUTER_TIMEOUT_MS
OPENROUTER_API_KEY=
# Point the AI tab at the v3 route instead of /api/ai/cql
# NEXT_PUBLIC_AI_CQL_ENDPOINT=/api/ai/v3/cql

# AI search v3.1 (/api/ai/v3.1/cql): v3 + hit count validation against FBI-API.
# The generated CQL is checked with complexSearch; on 0 hits the query is revised
# (LLM round, then deterministic relaxation) until something has hits.
# NEXT_PUBLIC_AI_CQL_ENDPOINT=/api/ai/v3.1/cql
# Optional: AI_CQL_VALIDATE=false (behave like v3), AI_CQL_LLM_RETRIES=1,
# AI_CQL_MAX_RELAXATIONS=6, AI_CQL_HITCOUNT_CONCURRENCY=3,
# AI_CQL_HITCOUNT_TIMEOUT_MS=6000, AI_CQL_VALIDATE_BUDGET_MS=12000,
# AI_CQL_FBI_API_URL=<graphql url> (default: origin of NEXT_PUBLIC_FBI_API_URL + /bibdk21/graphql)

# AI search v3.2 (/api/ai/v3.2/cql): v3.1 + worktype-only material filtering and
# creator names corrected with the first FBI-API suggestion.
# NEXT_PUBLIC_AI_CQL_ENDPOINT=/api/ai/v3.2/cql

# AI search v4 (/api/ai/v4/cql): the default the AI tab uses.
# LLM → AST (narrow field set: one person field, no issn/dk5) → every open value
# (person, subject, title, series, publisher, host publication, character,
# function) replaced by its FIRST complexSuggest suggestion → CQL. No hit count
# check and no relaxation.
# NEXT_PUBLIC_AI_CQL_ENDPOINT=/api/ai/v4/cql
# Optional: AI_CQL_SUGGEST=false (skip the catalogue lookup),
# AI_CQL_SUGGEST_TIMEOUT_MS=4000, AI_CQL_FBI_API_URL=<graphql url>
